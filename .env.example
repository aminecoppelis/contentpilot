# --- Infrastructure (jamais en base) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/post_generator
APP_BASE_URL=http://localhost:8000
SESSION_COOKIE_NAME=pg_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=720

# Laisser SMTP_HOST VIDE désactive proprement les emails : l'application
# fonctionne, les liens d'activation sont écrits dans les logs du serveur.
# Serveur de test local : docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   -> interface web sur http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Post Generator <no-reply@example.com>"
# Chiffrement : détecté automatiquement d'après le port
#   465  -> SSL implicite (SMTPS)   ex. SSL0.OVH.NET
#   587  -> STARTTLS                ex. Gmail, SendGrid, Brevo
#   25 / 1025 -> aucun              relais local, capteur ./mail.sh
# Ne renseigne ces deux variables que pour forcer un mode non standard.
SMTP_USE_TLS=false
SMTP_START_TLS=false

OPENROUTER_API_KEY=sk-or-xxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LOG_LEVEL=info
ENV=development

# --- Verrou du Worker (cf. doc §8.3) ---
WORKER_LOCK_MINUTES=15
WORKER_MAX_ATTEMPTS=3
